{
  "compilerOptions": {
    "target": "ES2021", "lib": ["ES2021", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "resolveJsonModule": true, "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@ajay/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src"]
}
