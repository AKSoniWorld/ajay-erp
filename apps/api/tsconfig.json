{
  "compilerOptions": {
    "target": "ES2021", "module": "commonjs", "moduleResolution": "node",
    "declaration": false, "outDir": "./dist", "baseUrl": "./",
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "strict": true, "strictPropertyInitialization": false,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "sourceMap": true, "incremental": false
  },
  "include": ["src", "tests"]
}
