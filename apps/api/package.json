    "argon2": "^0.40.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
