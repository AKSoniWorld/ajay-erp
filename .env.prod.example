# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=ajayjewellers.in
ACME_EMAIL=you@ajayjewellers.in

JWT_ACCESS_SECRET=        # openssl rand -base64 48
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGINS=https://ajayjewellers.in
LOGIN_RATE_LIMIT=5

# first admin (created only when no users exist yet)
ADMIN_NAME=Owner
ADMIN_MOBILE=
ADMIN_PASSWORD=           # at least 8 characters; change it after first login

PUBLIC_WHATSAPP_DEFAULT=  # e.g. 919876543210 (country code + number) for the customer catalog
BACKUP_KEEP_DAYS=14
